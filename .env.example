# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key
SUPABASE_SERVICE_KEY=eyJ...your-service-role-key

# ── Security ──────────────────────────────────────────────────
# Generate: openssl rand -hex 32
HASH_SALT=replace-with-64-char-random-string

# ── App URL ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://privpulse.in

# ── Upstash Redis (rate limiting) ─────────────────────────────
UPSTASH_REDIS_REST_URL=https://YOUR.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# ── Resend (weekly email digests) ─────────────────────────────
RESEND_API_KEY=re_your_key
EMAIL_FROM=digest@privpulse.in

# ── Lemon Squeezy (payments) ──────────────────────────────────
LEMONSQUEEZY_API_KEY=your_key
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_secret
LEMONSQUEEZY_STORE_ID=12345
LEMONSQUEEZY_INDIE_VARIANT_ID=11111
LEMONSQUEEZY_PRO_VARIANT_ID=22222
